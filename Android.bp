package {
    default_applicable_licenses: [evolution_sensor_block_license],
}

license {
    name: evolution_sensor_block_license,
    visibility: [:__subpackages__],
    license_kinds: [SPDX-license-identifier-Apache-2.0],
    license_text: [LICENSE],
}

// Compile inside Settings to use its platform privileges and theme.
filegroup {
    name: evolution-sensor-block-settings-srcs,
    srcs: [settings/src/**/*.kt],
    visibility: [//packages/apps/Settings:__pkg__],
}
