package {
    default_applicable_licenses: ["evolution_clipboard_access_license"],
}

license {
    name: "evolution_clipboard_access_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}

// Compile inside Settings to use its platform privileges and theme.
filegroup {
    name: "evolution-clipboard-access-settings-srcs",
    srcs: ["settings/src/**/*.kt"],
    visibility: ["//packages/apps/Settings:__pkg__"],
}
